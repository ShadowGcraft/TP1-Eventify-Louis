<form method="post" action="{{ path('app_event_delete', {id: event.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
    <button class="btn btn-outline-danger">Supprimer</button>
</form>
