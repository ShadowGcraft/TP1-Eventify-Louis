{% extends 'base.html.twig' %}

{% block title %}Les événements{% endblock %}

{% block body %}
    <h1 class="mb-4">Les événements</h1>

    {# GET et non POST : la recherche reste dans l'URL, donc partageable #}
    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <input type="text" name="q" value="{{ q }}" class="form-control" placeholder="Rechercher un titre">
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">Rechercher</button>
            <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary">Réinitialiser</a>
        </div>
    </form>

    <div class="row">
        {% for event in events %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ event.title }}</h5>
                        <p class="text-muted mb-2">
                            {{ event.eventDate|date('d/m/Y à H:i') }} — {{ event.location }}
                        </p>
                        {% if event.capacity > 0 %}
                            <span class="badge bg-success">{{ event.capacity }} place(s)</span>
                        {% else %}
                            <span class="badge bg-danger">Complet</span>
                        {% endif %}
                    </div>
                    <div class="card-footer bg-white">
                        <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                        <a href="{{ path('app_event_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun événement trouvé.</p>
        {% endfor %}
    </div>
{% endblock %}
